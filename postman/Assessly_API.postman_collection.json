{
  "info": {
    "_postman_id": "assessly-api-collection-v1",
    "name": "Assessly API",
    "description": "Postman collection for the Assessly Online Exam Management & Self-Assessment Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Root Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.environment.set('authToken', json.data.token);",
                  "        pm.collectionVariables.set('authToken', json.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Abebe Bikila\",\n  \"email\": \"abebe@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"departmentIds\": [\"00000000-0000-0000-0000-000000000000\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.environment.set('authToken', json.data.token);",
                  "        pm.collectionVariables.set('authToken', json.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"abebe@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Abebe B. Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List Active Departments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/departments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "departments"]
            }
          }
        },
        {
          "name": "Create Department (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CS-101\",\n  \"name\": \"Computer Science\",\n  \"description\": \"Department of Computer Science & Software Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/departments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "departments"]
            }
          }
        }
      ]
    },
    {
      "name": "Questions & Practice",
      "item": [
        {
          "name": "List Questions",
          "description": "Returns sanitized questions for students (no isCorrect or explanation) or full view for admins.",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "departmentId", "value": "", "disabled": true },
                { "key": "difficulty", "value": "MEDIUM", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Question (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentId\": \"00000000-0000-0000-0000-000000000000\",\n  \"body\": \"Which data structure operates on a First-In-First-Out (FIFO) principle?\",\n  \"topic\": \"Data Structures\",\n  \"difficulty\": \"EASY\",\n  \"marks\": 1.0,\n  \"explanation\": \"A Queue processes elements in FIFO order, unlike a Stack which is LIFO.\",\n  \"status\": \"PUBLISHED\",\n  \"options\": [\n    { \"optionText\": \"Stack\", \"isCorrect\": false },\n    { \"optionText\": \"Queue\", \"isCorrect\": true },\n    { \"optionText\": \"Tree\", \"isCorrect\": false },\n    { \"optionText\": \"Graph\", \"isCorrect\": false }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions"]
            }
          }
        },
        {
          "name": "Update Question (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"difficulty\": \"MEDIUM\",\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "question-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "Submit Practice Answer (Student)",
          "description": "Submits an answer to a question. Atomically checks & decrements trial quota (5 free) or verifies active entitlement. Returns immediate score, correct answer, and explanation.",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"selectedOptionId\": \"option-uuid-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/:id/answer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", ":id", "answer"],
              "variable": [
                {
                  "key": "id",
                  "value": "question-uuid-here"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Entitlements & Quota",
      "item": [
        {
          "name": "Get Trial Quota & Entitlement Status",
          "description": "Returns remaining free attempts, usage counter, and active package entitlements for the current student.",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entitlements/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "entitlements", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments & Verification",
      "item": [
        {
          "name": "Get Payment Instructions (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/instructions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "instructions"]
            }
          }
        },
        {
          "name": "Get Purchasable Packages (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/packages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "packages"]
            }
          }
        },
        {
          "name": "Submit Payment Receipt (Student)",
          "description": "Student uploads payment receipt image/PDF with transaction reference code. Saved with PENDING status.",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "packageId",
                  "value": "package-uuid-here",
                  "type": "text"
                },
                {
                  "key": "channel",
                  "value": "TELEBIRR",
                  "type": "text"
                },
                {
                  "key": "transactionRef",
                  "value": "FT123456789",
                  "type": "text"
                },
                {
                  "key": "receipt",
                  "type": "file"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"]
            }
          }
        },
        {
          "name": "Get My Payment History (Student)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "me"]
            }
          }
        },
        {
          "name": "Admin: Review Queue",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/admin/queue?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "admin", "queue"],
              "query": [
                { "key": "status", "value": "PENDING" }
              ]
            }
          }
        },
        {
          "name": "Admin: Approve Payment & Unlock Entitlement",
          "description": "Atomically marks payment APPROVED and creates an active Entitlement for the student.",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decisionNote\": \"Telebirr transaction verified against merchant statement.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/admin/:id/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "admin", ":id", "approve"],
              "variable": [
                { "key": "id", "value": "payment-uuid-here" }
              ]
            }
          }
        },
        {
          "name": "Admin: Reject Payment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decisionNote\": \"Invalid screenshot or transaction code mismatch.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/admin/:id/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "admin", ":id", "reject"],
              "variable": [
                { "key": "id", "value": "payment-uuid-here" }
              ]
            }
          }
        },
        {
          "name": "Admin: Create Package",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Full Academic Year Access\",\n  \"price\": 799.00,\n  \"currency\": \"ETB\",\n  \"scope\": \"ALL_DEPARTMENTS\",\n  \"durationDays\": 365,\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/admin/packages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "admin", "packages"]
            }
          }
        },
        {
          "name": "Admin: Configure Payment Settings",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"TELEBIRR\",\n  \"displayName\": \"Assessly Telebirr Account\",\n  \"accountDetails\": \"+251911223344\",\n  \"instructions\": \"Send payment and submit the transaction confirmation code and screenshot.\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/admin/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "admin", "settings"]
            }
          }
        }
      ]
    }
  ]
}
